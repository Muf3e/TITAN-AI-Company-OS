OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# GPT-5.6 Luna is the default cost-efficient production model. Override for another provider/model.
OPENAI_MODEL=gpt-5.6-luna
DATABASE_URL=
DATABASE_SSL=true
PORT=4173
# Stripe secret API key. Never commit the real key.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (preferred for webhook authenticity). Never commit the real secret.
STRIPE_WEBHOOK_SECRET=
# Optional Razorpay webhook signing secret.
RAZORPAY_WEBHOOK_SECRET=
